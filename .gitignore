# ==============================
# DevPrep .gitignore
# ==============================

# OS
.DS_Store
Thumbs.db

# ==============================
# Backend - Java / Gradle
# ==============================
.gradle/
**/build/

# Gradle Wrapper
!**/gradle/wrapper/gradle-wrapper.jar

# ==============================
# Eclipse / STS
# ==============================
.classpath
.project
.settings/
.factorypath
.springBeans
.sts4-cache/
.apt_generated/
bin/

# ==============================
# IntelliJ IDEA
# ==============================
.idea/
*.iml
*.iws
*.ipr
out/

# ==============================
# VS Code
# ==============================
.vscode/

# ==============================
# Frontend - React / Vite
# ==============================
**/node_modules/
**/dist/
**/.vite/

# ==============================
# Environment / Secrets
# ==============================
.env
.env.*
!.env.example

# ==============================
# Logs / Temporary
# ==============================
*.log
logs/
*.tmp
*.temp
*.swp
*.swo

# ==============================
# Coverage
# ==============================
coverage/
.nyc_output/
